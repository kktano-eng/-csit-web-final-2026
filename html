<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CSIT Web Finals 2026 | Modern Web Showcase</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <!-- Navigation Bar -->
  <header class="navbar" id="navbar">
    <div class="container nav-container">
      <a href="#" class="logo">CSIT<span>2026</span></a>
      
      <nav class="nav-links" id="nav-links">
        <a href="#home">Home</a>
        <a href="#features">Features</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </nav>

      <div class="nav-actions">
        <button id="theme-toggle" class="icon-btn" aria-label="Toggle Dark/Light Mode">
          ☀️
        </button>
        <button id="menu-toggle" class="hamburger" aria-label="Toggle Menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section id="home" class="hero">
    <div class="container hero-content">
      <span class="badge">CSIT Web Development Finals • 2026</span>
      <h1>Building Fast, Modern & Interactive Web Experiences.</h1>
      <p>
        A clean, responsive, and accessible web application built with semantic HTML5, 
        modern CSS variables, and vanilla JavaScript.
      </p>
      <div class="hero-buttons">
        <a href="#projects" class="btn btn-primary">Explore Showcase</a>
        <a href="#contact" class="btn btn-secondary">Get in Touch</a>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="section">
    <div class="container">
      <div class="section-header">
        <h2>Core Architecture</h2>
        <p>Engineered for performance, responsiveness, and clean user experience.</p>
      </div>

      <div class="grid-3">
        <div class="card feature-card">
          <div class="icon">⚡</div>
          <h3>Responsive Layout</h3>
          <p>Built with CSS Grid and Flexbox to adapt seamlessly across mobile, tablet, and desktop screens.</p>
        </div>
        <div class="card feature-card">
          <div class="icon">🌓</div>
          <h3>Dynamic Theming</h3>
          <p>Persistent Dark and Light mode switching powered by CSS custom properties and LocalStorage.</p>
        </div>
        <div class="card feature-card">
          <div class="icon">🔍</div>
          <h3>Live Filtering</h3>
          <p>Instant DOM manipulation and category filtering without page reloads or external libraries.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Projects / Showcase Section -->
  <section id="projects" class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Featured Work</h2>
        <p>Filter by category or search dynamically to explore items.</p>
      </div>

      <!-- Filter & Search Controls -->
      <div class="controls">
        <div class="filter-buttons" id="filter-buttons">
          <button class="filter-btn active" data-filter="all">All</button>
          <button class="filter-btn" data-filter="web">Web App</button>
          <button class="filter-btn" data-filter="ui">UI/UX Design</button>
          <button class="filter-btn" data-filter="system">System</button>
        </div>
        <input 
          type="text" 
          id="search-input" 
          class="search-input" 
          placeholder="Search projects..." 
          aria-label="Search projects"
        />
      </div>

      <!-- Project Grid (Populated via JS or static fallback) -->
      <div class="grid-3" id="project-grid">
        <article class="card project-card" data-category="web">
          <span class="tag">Web App</span>
          <h3>Student Portal Dashboard</h3>
          <p>Real-time grade tracking, schedule viewer, and announcement feed built for university students.</p>
          <button class="btn-link open-modal" data-title="Student Portal Dashboard" data-desc="Full-stack responsive student portal featuring live GPA calculation, dark mode, and interactive calendar views.">View Details →</button>
        </article>

        <article class="card project-card" data-category="ui">
          <span class="tag">UI/UX Design</span>
          <h3>EcoTrack Mobile Interface</h3>
          <p>Minimalist carbon footprint tracker with accessible color contrast and micro-interactions.</p>
          <button class="btn-link open-modal" data-title="EcoTrack Mobile Interface" data-desc="Designed with WCAG AAA contrast standards, custom SVG charts, and streamlined daily habit logging.">View Details →</button>
        </article>

        <article class="card project-card" data-category="system">
          <span class="tag">System</span>
          <h3>Inventory & POS Engine</h3>
          <p>Browser-based point-of-sale and stock management tool with LocalStorage persistence.</p>
          <button class="btn-link open-modal" data-title="Inventory & POS Engine" data-desc="Supports barcode input simulation, automated receipt generation, and low-stock alerts.">View Details →</button>
        </article>
      </div>
      <p id="no-results" class="no-results hidden">No matching items found.</p>
    </div>
  </section>

  <!-- Contact Section with Live Validation -->
  <section id="contact" class="section">
    <div class="container contact-container">
      <div class="section-header">
        <h2>Contact & Feedback</h2>
        <p>Send a message—complete with real-time JavaScript input validation.</p>
      </div>

      <form id="contact-form" class="contact-form" novalidate>
        <div class="form-group">
          <label for="name">Full Name</label>
          <input type="text" id="name" placeholder="Juan Dela Cruz" required />
          <small class="error-msg" id="name-error"></small>
        </div>

        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" placeholder="juan@example.com" required />
          <small class="error-msg" id="email-error"></small>
        </div>

        <div class="form-group">
          <label for="message">Message</label>
          <textarea id="message" rows="4" placeholder="Write your message here..." required></textarea>
          <small class="error-msg" id="message-error"></small>
        </div>

        <button type="submit" class="btn btn-primary full-width">Send Message</button>
        <div id="form-status" class="form-status"></div>
      </form>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container footer-content">
      <p>&copy; 2026 CSIT Web Finals. Built with clean HTML, CSS & JS.</p>
      <a href="#home" class="back-to-top">Back to top ↑</a>
    </div>
  </footer>

  <!-- Details Modal -->
  <div id="modal" class="modal hidden" role="dialog" aria-modal="true">
    <div class="modal-content">
      <button id="close-modal" class="close-modal" aria-label="Close modal">&times;</button>
      <h3 id="modal-title">Project Title</h3>
      <p id="modal-desc">Project description goes here.</p>
    </div>
  </div>

  <script src="script.js"></script>
</body>
</html>
